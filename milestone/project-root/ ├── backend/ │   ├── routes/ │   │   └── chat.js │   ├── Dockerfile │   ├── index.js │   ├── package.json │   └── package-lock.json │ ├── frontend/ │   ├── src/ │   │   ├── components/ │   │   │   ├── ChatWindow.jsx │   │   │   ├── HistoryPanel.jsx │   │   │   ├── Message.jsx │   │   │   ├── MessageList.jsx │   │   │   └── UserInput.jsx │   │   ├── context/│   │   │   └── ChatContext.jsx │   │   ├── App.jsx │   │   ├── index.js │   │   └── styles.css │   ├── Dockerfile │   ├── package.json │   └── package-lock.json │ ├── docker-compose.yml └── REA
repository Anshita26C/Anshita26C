version: "3.8"
services:
  backend:
    build: ./backend
    ports:
      - "5000:5000"
    depends_on:
      - mongo
    environment:
      - DB_URL=mongodb://mongo:27017/chatbot
    networks:
      - chatbot

  frontend:
    build: ./frontend
    ports:
      - "3000:3000"
    depends_on:
      - backend
    networks:
      - chatbot

  mongo:
    image: mongo:5
    container_name: chatbot-mongo
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
    networks:
      - chatbot

volumes:
  mongo_data:

networks:
  chatbot:
