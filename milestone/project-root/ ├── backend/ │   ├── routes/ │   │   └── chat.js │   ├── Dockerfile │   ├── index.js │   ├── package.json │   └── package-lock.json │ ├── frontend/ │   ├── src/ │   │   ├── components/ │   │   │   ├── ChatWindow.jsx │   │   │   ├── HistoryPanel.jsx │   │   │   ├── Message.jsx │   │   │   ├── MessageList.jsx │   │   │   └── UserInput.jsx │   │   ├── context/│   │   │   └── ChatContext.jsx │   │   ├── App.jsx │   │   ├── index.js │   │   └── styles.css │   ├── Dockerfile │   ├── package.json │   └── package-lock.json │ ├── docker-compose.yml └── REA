import mongoose from 'mongoose';

const messageSchema = new mongoose.Schema({
  sender: String,
  text: String
}, { timestamps: true });

const conversationSchema = new mongoose.Schema({
  title: String,
  messages: [messageSchema]
}, { timestamps: true });

export default mongoose.model('Conversation', conversationSchema);
import express from 'express';
import Conversation from '../models/Conversation.js';
const router = express.Router();

router.post('/chat', async (req, res) => {
  const { message, sessionId } = req.body;

  const aiResponse = {
    sender: "ai",
    text: `AI response to: "${message}"`
  };

  let conversation = await Conversation.findById(sessionId);
  if (!conversation) {
    conversation = new Conversation({
      _id: sessionId,
      title: `Session ${new Date().toLocaleString()}`,
      messages: []
    });
  }

  conversation.messages.push({ sender: 'user', text: message });
  conversation.messages.push(aiResponse);
  await conversation.save();

  res.json({ response: aiResponse, session: conversation });
});

router.get('/sessions', async (req, res) => {
  const sessions = await Conversation.find({}, '_id title messages');
  res.json(sessions);
});

export default router;
