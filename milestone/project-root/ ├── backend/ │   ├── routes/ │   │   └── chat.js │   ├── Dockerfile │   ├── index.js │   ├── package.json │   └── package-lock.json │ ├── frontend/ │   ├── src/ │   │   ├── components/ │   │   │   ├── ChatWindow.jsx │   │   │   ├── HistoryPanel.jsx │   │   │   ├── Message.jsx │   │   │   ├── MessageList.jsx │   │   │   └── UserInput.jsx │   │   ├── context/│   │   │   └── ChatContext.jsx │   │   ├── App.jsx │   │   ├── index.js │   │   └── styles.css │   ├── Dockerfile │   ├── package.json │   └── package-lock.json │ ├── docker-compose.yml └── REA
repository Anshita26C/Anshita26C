import React from "react";
import { ChatProvider } from "./context/ChatContext";
import ChatWindow from "./components/ChatWindow";

const App = () => (
  <ChatProvider>
    <ChatWindow />
  </ChatProvider>
);

export default App;
import React, { createContext, useContext, useState, useEffect } from "react";

const ChatContext = createContext();
export const useChat = () => useContext(ChatContext);

export const ChatProvider = ({ children }) => {
  const [messages, setMessages] = useState([]);
  const [loading, setLoading] = useState(false);
  const [input, setInput] = useState("");
  const [conversations, setConversations] = useState([]);
  const [selectedConversationId, setSelectedConversationId] = useState(null);

  const addMessage = (msg) => setMessages((prev) => [...prev, msg]);
  const clearMessages = () => setMessages([]);

  useEffect(() => {
    fetch("http://localhost:5000/api/sessions")
      .then((res) => res.json())
      .then(setConversations)
      .catch(console.error);
  }, []);

  return (
    <ChatContext.Provider
      value={{
        messages,
        loading,
        input,
        setInput,
        setLoading,
        addMessage,
        conversations,
        setConversations,
        setSelectedConversationId,
        selectedConversationId,
        clearMessages,
        setMessages,
      }}
    >
      {children}
    </ChatContext.Provider>
  );
};
import React from "react";
import MessageList from "./MessageList";
import UserInput from "./UserInput";
import HistoryPanel from "./HistoryPanel";
import { useChat } from "../context/ChatContext";

const ChatWindow = () => {
  const { loading } = useChat();

  return (
    <div className="chat-container">
      <HistoryPanel />
      <div className="chat-window">
        <MessageList />
        {loading && <div className="loading">Typing...</div>}
        <UserInput />
      </div>
    </div>
  );
};

export default ChatWindow;
import React from "react";
import { useChat } from "../context/ChatContext";

const UserInput = () => {
  const {
    input,
    setInput,
    addMessage,
    setLoading,
    selectedConversationId,
    setConversations,
    setSelectedConversationId,
  } = useChat();

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!input.trim()) return;

    const userMsg = { sender: "user", text: input };
    addMessage(userMsg);
    setInput("");
    setLoading(true);

    const sessionId = selectedConversationId || Date.now().toString();

    const res = await fetch("http://localhost:5000/api/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ message: input, sessionId }),
    });

    const data = await res.json();
    addMessage(data.response);
    setSelectedConversationId(data.session._id);

    // Optional: refresh conversation list
    const sessionRes = await fetch("http://localhost:5000/api/sessions");
    const sessions = await sessionRes.json();
    setConversations(sessions);

    setLoading(false);
  };

  return (
    <form className="user-input" onSubmit={handleSubmit}>
      <input
        type="text"
        value={input}
        onChange={(e) => setInput(e.target.value)}
        placeholder="Type your message..."
      />
      <button type="submit">Send</button>
    </form>
  );
};

export default UserInput;
import React from "react";
import { useChat } from "../context/ChatContext";
import Message from "./Message";

const MessageList = () => {
  const { messages } = useChat();

  return (
    <div className="message-list">
      {messages.map((msg, i) => (
        <Message key={i} sender={msg.sender} text={msg.text} />
      ))}
    </div>
  );
};

export default MessageList;
import React from "react";

const Message = ({ sender, text }) => {
  return (
    <div className={`message ${sender === "user" ? "user" : "ai"}`}>
      <div className="bubble">{text}</div>
    </div>
  );
};

export default Message;
import React from "react";
import { useChat } from "../context/ChatContext";

const HistoryPanel = () => {
  const {
    conversations,
    setSelectedConversationId,
    selectedConversationId,
    setMessages,
  } = useChat();

  const handleSelect = (session) => {
    setSelectedConversationId(session._id);
    setMessages(session.messages);
  };

  return (
    <div className="history-panel">
      <h3>Conversation History</h3>
      {conversations.map((s) => (
        <div
          key={s._id}
          className={`history-item ${
            selectedConversationId === s._id ? "active" : ""
          }`}
          onClick={() => handleSelect(s)}
        >
          {s.title}
        </div>
      ))}
    </div>
  );
};

export default HistoryPanel;
body {
  font-family: sans-serif;
  margin: 0;
  background: #f4f4f4;
}

.chat-container {
  display: flex;
  height: 100vh;
}

.history-panel {
  width: 250px;
  background: #eeeeee;
  padding: 10px;
  border-right: 1px solid #ccc;
  overflow-y: auto;
}

.history-item {
  padding: 10px;
  margin-bottom: 5px;
  cursor: pointer;
  background: white;
  border-radius: 5px;
}

.history-item.active {
  background-color: #d0ebff;
}

.chat-window {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 10px;
}

.message-list {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 10px;
}

.message {
  margin: 5px 0;
}

.message.user .bubble {
  background: #d1ffd1;
  align-self: flex-end;
}

.message.ai .bubble {
  background: #e2e2ff;
  align-self: flex-start;
}

.bubble {
  padding: 10px;
  border-radius: 10px;
  max-width: 60%;
  display: inline-block;
}

.user-input {
  display: flex;
  gap: 10px;
}

.user-input input {
  flex: 1;
  padding: 10px;
}

.user-input button {
  padding: 10px 20px;
}

.loading {
  margin-bottom: 10px;
  font-style: italic;
}
