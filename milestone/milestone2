// milestone2/backend/app.js const express = require('express'); const app = express(); const chatbotRoutes = require('./routes/chatbot'); const connectionRoutes = require('./routes/connections');

app.use(express.json()); app.use('/api/chatbot', chatbotRoutes); app.use('/api/connections', connectionRoutes);

const PORT = process.env.PORT || 5000; app.listen(PORT, () => console.log(Milestone 2 Server running on port ${PORT}));

// milestone2/backend/routes/connections.js const express = require('express'); const router = express.Router(); const { loadCSV } = require('../utils/csvLoader'); const path = require('path');

const usersPath = path.join(__dirname, '../data/users.csv'); let users = [];

loadCSV(usersPath).then(data => users = data);

// Build graph where users are nodes and same city users are connected function buildGraph() { const graph = {}; users.forEach(user => { const city = user.city; if (!graph[city]) graph[city] = []; graph[city].push(user.id); }); return graph; }

// Find shortest path between users by same city (simplified logic) function findConnectionPath(userA, userB) { const graph = buildGraph(); const user1 = users.find(u => u.id === userA); const user2 = users.find(u => u.id === userB);

if (!user1 || !user2) return []; if (user1.city !== user2.city) return [];

// For simplicity, direct path if same city return [user1.id, user2.id]; }

router.get('/shortest-path', (req, res) => { const { from, to } = req.query; if (!from || !to) return res.status(400).json({ message: 'Missing user IDs' });

const path = findConnectionPath(from, to); if (path.length === 0) return res.status(404).json({ message: 'No connection found' });

res.json({ path }); });

module.exports = router;

// milestone2/backend/utils/csvLoader.js const fs = require('fs'); const csv = require('csv-parser');

function loadCSV(filePath) { return new Promise((resolve, reject) => { const results = []; fs.createReadStream(filePath) .pipe(csv()) .on('data', (data) => results.push(data)) .on('end', () => resolve(results)) .on('error', reject); }); }

module.exports = { loadCSV };
